#. (itstool) path: info/desc
#: C/connect.page:14
msgid "Connect to a remote machine over the network."
msgstr "Koble til en fjernmaskin over nettverket."

#. (itstool) path: page/title
#: C/connect.page:20
msgid "Connect to another computer"
msgstr "Koble til en annen datamaskin"

#. (itstool) path: page/p
#: C/connect.page:22
msgid ""
"<app>Connections</app> can be used to view and access a remote machine."
msgstr "<app>Fjernstyring</app> kan brukes til å se og få tilgang til en fjernmaskin."

#. (itstool) path: note/p
#: C/connect.page:25
msgid "The remote machine should already be configured."
msgstr "Den eksterne maskinen bør allerede være konfigurert."

#. (itstool) path: item/p
#: C/connect.page:29
msgid ""
"Click <gui style=\"button\">+</gui> in the top left corner to launch the "
"remote connection creation assistant."
msgstr ""
"Klikk <gui style=\"button\">+</gui> i øverste venstre hjørne for å starte "
"veiviseren for opprettelse av fjernkobling."

#. (itstool) path: item/p
#: C/connect.page:32
msgid ""
"Enter a URL containing the protocol, IP address and port number of the "
"remote device or service. For example:"
msgstr ""
"Skriv inn en URL som inneholder protokoll, IP-adresse og portnummer for den "
"eksterne enheten eller tjenesten. For eksempel:"

#. (itstool) path: item/code
#: C/connect.page:34
#, no-wrap
msgid "vnc://192.168.122.1:5900"
msgstr "vnc://192.168.122.1:5900"

#. (itstool) path: item/p
#: C/connect.page:35
msgid "The protocol will be:"
msgstr "The protocol will be:"

#. (itstool) path: item/p
#: C/connect.page:37
msgid "rdp:// to connect to a remote <app>RDP</app> server."
msgstr "rdp:// for å koble til en fjern <app>RDP</app> server."

#. (itstool) path: item/p
#: C/connect.page:38
msgid ""
"vnc:// to connect to a remote <app>vino</app> or <app>VNC</app> server."
msgstr ""
"vnc:// for å koble til en fjern <app>Vino</app>- eller "
"<app>VNC</app>-server."

#. (itstool) path: item/p
#: C/connect.page:40
msgid "spice:// to connect to a remote <app>SPICE</app> server."
msgstr "spice:// for å koble til en fjern <app>SPICE</app>-server."

#. (itstool) path: note/p
#: C/connect.page:43
msgid ""
"The address and port number should be available from the configuration of "
"the device or service on the remote machine."
msgstr ""
"Adressen og portnummeret må være tilgjengelig fra konfigurasjonen av enheten"
" eller tjenesten på den fjerne maskinen."

#. (itstool) path: item/p
#: C/connect.page:47
msgid "Click <gui style=\"button\">Create</gui>."
msgstr "Klikk <gui style=\"button\">Opprett</gui>."

#. (itstool) path: page/p
#: C/connect.page:50
msgid "The remote machine will open in the collection view."
msgstr "Den eksterne maskinen åpnes i samlevisningen."

