#. (itstool) path: info/desc
#: C/connect.page:14
msgid "Connect to a remote machine over the network."
msgstr "Kople til ei fjernmaskin over nettverket."

#. (itstool) path: page/title
#: C/connect.page:20
msgid "Connect to another computer"
msgstr "Kople til ei anna datamaskin"

#. (itstool) path: page/p
#: C/connect.page:22
msgid "<app>Connections</app> can be used to view and access a remote machine."
msgstr ""
"<app>Tilkoplingar</app> kan brukast til å sjå og styre ei fjernmaskin."

#. (itstool) path: note/p
#: C/connect.page:25
msgid "The remote machine should already be configured."
msgstr "Fjernmaskina må vere sett opp på førehand."

#. (itstool) path: item/p
#: C/connect.page:29
msgid ""
"Click <gui style=\"button\">+</gui> in the top left corner to launch the "
"remote connection creation assistant."
msgstr ""
"Klikk <gui style=\"button\">+</gui> øvst til venstre for å starte vegvisaren"
" for ny fjerntilkopling."

#. (itstool) path: item/p
#: C/connect.page:32
msgid ""
"Enter a URL containing the protocol, IP address and port number of the "
"remote device or service. For example:"
msgstr ""
"Skriv inn ein URL med protokollen, IP-adressa og portnummeret til "
"fjerneininga eller tenesta. Til dømes:"

#. (itstool) path: item/code
#: C/connect.page:34
#, no-wrap
msgid "vnc://192.168.122.1:5900"
msgstr "vnc://192.168.122.1:5900"

#. (itstool) path: item/p
#: C/connect.page:35
msgid "The protocol will be:"
msgstr "Protokollen skal vere:"

#. (itstool) path: item/p
#: C/connect.page:37
msgid "rdp:// to connect to a remote <app>RDP</app> server."
msgstr "rdp:// for å kople til ein <app>RDP</app>-tenar over nettet."

#. (itstool) path: item/p
#: C/connect.page:38
msgid "vnc:// to connect to a remote <app>vino</app> or <app>VNC</app> server."
msgstr ""
"vnc:// for å kople til ein <app>vino</app>- eller <app>VNC</app>-tenar over "
"nettet."

#. (itstool) path: item/p
#: C/connect.page:40
msgid "spice:// to connect to a remote <app>SPICE</app> server."
msgstr "spice:// for å kople til ein <app>SPICE</app>-tenar over nettet."

#. (itstool) path: note/p
#: C/connect.page:43
msgid ""
"The address and port number should be available from the configuration of "
"the device or service on the remote machine."
msgstr ""
"Adressa og portnummeret finn du i oppsettet til eininga eller tenesta på "
"fjernmaskina."

#. (itstool) path: item/p
#: C/connect.page:47
msgid "Click <gui style=\"button\">Create</gui>."
msgstr "Klikk <gui style=\"button\">Lag</gui>."

#. (itstool) path: page/p
#: C/connect.page:50
msgid "The remote machine will open in the collection view."
msgstr "Fjernmaskina vert opna i samlingsvisinga."

